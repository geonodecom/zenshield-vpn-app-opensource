# Secrets / per-developer config.
# NOTE: android/app/google-services.json, macos/Runner/GoogleService-Info.plist,
# and lib/firebase_options.dart are intentionally NOT ignored — this repo
# ships placeholder versions of all three (Android + Windows + macOS are the
# platforms in scope) so the app builds and runs without any Firebase setup.
# Run `flutterfire configure` to replace them with your own project's real
# values. iOS is NOT part of this OSS release, so its plist stays ignored.
ios/Runner/GoogleService-Info.plist
android/app/*.jks
android/key.properties
windows/packaging/exe/make_config.local.yaml
secrets.json
# Local Hive/SQLite dev databases — one was found committed with a real API
# key + user id baked in (geonode_sdk/prefsbox.hive), never let that recur.
*.hive
*.sqlite
*.sqlite3

# Native binaries built from public source repos at build time — see
# windows/packaging/build_native.sh, android/fetch_native.sh,
# macos/fetch_native.sh, and ios/fetch_native.sh
/singbox-tunnel.exe
/windows/runner/singbox-tunnel.exe
/windows/core/zenshield_core.dll
/windows/core/zenshield_core.h
/android/app/libs/ZenshieldBox.aar
/android/app/libs/ZenshieldBox-sources.jar
/macos/zenshieldBox.xcframework/
/ios/ZenshieldBox.xcframework/